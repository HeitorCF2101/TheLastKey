{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "--configuration",
                "Debug",
                "--nologo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: build ExportDebug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "--configuration",
                "ExportDebug",
                "--nologo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
